# Whitelist-style gitignore: track only Assets/GameLyftSDK/ + a few root files

# Ignore everything at the repo root
/*

# But keep these
!/.gitignore
!/LICENSE
!/README.md

# Walk into Assets/ ...
!/Assets/

# ... ignore everything inside it ...
/Assets/*

# ... except the GameLyftSDK package
!/Assets/GameLyftSDK/
